<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BioAttend" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorPrimaryVariant">@color/neon_blue</item>
        <item name="colorOnPrimary">@color/bg_dark_obsidian</item>
        <item name="android:windowBackground">@color/bg_dark_obsidian</item>
        <item name="android:statusBarColor">@color/bg_dark_obsidian</item>
        <item name="android:navigationBarColor">@color/bg_dark_obsidian</item>
    </style>

    <!-- Glass Dialog Theme with High-Contrast Action Buttons -->
    <style name="GlassDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@drawable/bg_glass_card</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.75</item>
        <item name="colorAccent">@color/neon_cyan</item>
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorOnPrimary">@color/bg_dark_obsidian</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/GlassDialogPositiveButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/GlassDialogNegativeButton</item>
    </style>

    <style name="GlassDialogPositiveButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">#070A14</item>
        <item name="backgroundTint">@color/neon_cyan</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="GlassDialogNegativeButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
