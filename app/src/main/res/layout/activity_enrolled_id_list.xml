<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageButton
            android:id="@+id/btnBackEnrolledList"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/neon_cyan" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Enrolled Sensor IDs (Excel View)"
            android:textColor="@color/neon_cyan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btnExportEnrolledCsv"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_emerald"
            android:text="Export CSV"
            android:textColor="@color/bg_dark_obsidian"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Memory Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvHwMemoryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R307S SENSOR MEMORY: Loading used slots..."
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Zoom & Search Control Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/etSearchEnrolled"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:hint="Search by name, ID, or enrollment..."
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnEnrolledZoomReset"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_glass_card"
            android:text=" Pinch to Zoom (100%)"
            android:textColor="@color/neon_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBarEnrolledList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <!-- Zoomable Container -->
    <com.mpc.bioattend.util.ZoomableFrameLayout
        android:id="@+id/zoomableEnrolledContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Excel Table Horizontal & Vertical Scroll Container -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/layoutEnrolledTableRoot"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Excel Table Header -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1E293B"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="6dp">

                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="Sr.No" android:textColor="@color/neon_cyan" android:textStyle="bold" android:textSize="11sp" android:gravity="center" />
                    <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Finger ID" android:textColor="@color/neon_cyan" android:textStyle="bold" android:textSize="11sp" android:gravity="center" />
                    <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Student Name" android:textColor="@color/neon_cyan" android:textStyle="bold" android:textSize="11sp" />
                    <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Class/Sem" android:textColor="@color/neon_cyan" android:textStyle="bold" android:textSize="11sp" />
                    <TextView android:layout_width="75dp" android:layout_height="wrap_content" android:text="GR.No" android:textColor="@color/neon_cyan" android:textStyle="bold" android:textSize="11sp" />
                    <TextView android:layout_width="110dp" android:layout_height="wrap_content" android:text="Enrollment No" android:textColor="@color/neon_cyan" android:textStyle="bold" android:textSize="11sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEnrolledExcelTable"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent" />
            </LinearLayout>
        </HorizontalScrollView>
    </com.mpc.bioattend.util.ZoomableFrameLayout>

    <TextView
        android:id="@+id/tvEmptyEnrolledState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="No enrolled sensor fingerprint records found."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
