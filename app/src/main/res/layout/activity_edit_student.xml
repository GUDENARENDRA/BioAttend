<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/tvEditStudentPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Record Editor"
            android:textColor="@color/neon_cyan"
            android:textSize="26sp"
            android:textStyle="bold"
            android:shadowColor="@color/neon_cyan"
            android:shadowRadius="10"
            android:layout_marginBottom="24dp" />

        <!-- Input Fields Container Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name *"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etPageStudentName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#0F1626"
                android:hint="Enter Full Name"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Enrollment No -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enrollment No *"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etPageEnrollmentNo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#0F1626"
                android:hint="Enter Enrollment No (e.g. 23ICT001)"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Class / Semester -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Class / Semester *"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <AutoCompleteTextView
                android:id="@+id/etPageClassSem"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#0F1626"
                android:hint="Enter Class / Semester (e.g. Sem 7-ICT)"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:completionThreshold="1"
                android:layout_marginBottom="16dp" />

            <!-- GR.No -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GR.No *"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <AutoCompleteTextView
                android:id="@+id/etPageGrNo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#0F1626"
                android:hint="Enter GR.No (e.g. GR1020)"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:completionThreshold="1"
                android:layout_marginBottom="16dp" />

            <!-- Fingerprint ID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fingerprint Sensor ID (Optional)"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etPageFingerId"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#0F1626"
                android:hint="Enter Sensor Slot ID"
                android:inputType="number"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnSaveStudentRecord"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_button_cyan"
                android:text="SAVE RECORD"
                android:textColor="@color/bg_dark_obsidian"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCancelStudentRecord"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="CANCEL"
                android:textColor="@color/neon_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
