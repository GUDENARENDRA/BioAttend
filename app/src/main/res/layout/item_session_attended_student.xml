<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSessionStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Student Name"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSessionEnrollNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enrollment: 23ICT001 | Sem 7-ICT"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvSessionUserDataDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Finger ID: Slot 1 | GR: 1001 | Total Attended: 12"
            android:textColor="@color/neon_cyan"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSessionTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#2000F5A0"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="PRESENT "
        android:textColor="@color/neon_emerald"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
