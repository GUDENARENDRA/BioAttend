<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingHorizontal="6dp"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical">

    <!-- 1. Sr.No -->
    <TextView
        android:id="@+id/tvExcelSrNo"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textColor="@color/neon_cyan"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- 2. Fingerprint ID -->
    <TextView
        android:id="@+id/tvExcelFingerprintId"
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="Slot 1"
        android:textColor="@color/neon_violet"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- 2. Student Name -->
    <TextView
        android:id="@+id/tvExcelStudentName"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:text="Student Name"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingHorizontal="4dp" />

    <!-- 3. Class / Sem -->
    <TextView
        android:id="@+id/tvExcelClassSem"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:text="Sem 7-ICT"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:gravity="center" />

    <!-- 4. GR.No -->
    <TextView
        android:id="@+id/tvExcelGrNo"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="GR1020"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:gravity="center" />

    <!-- 5. Enrollment No -->
    <TextView
        android:id="@+id/tvExcelEnrollmentNo"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:text="23ICT001"
        android:textColor="@color/neon_amber"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- 8. Attended Classes Count -->
    <TextView
        android:id="@+id/tvExcelAttendedCount"
        android:layout_width="65dp"
        android:layout_height="wrap_content"
        android:text="4"
        android:textColor="@color/neon_emerald"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- 9. Edit & Delete Action Buttons -->
    <LinearLayout
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnEditExcelStudent"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/neon_cyan" />

        <ImageButton
            android:id="@+id/btnDeleteExcelStudent"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/neon_red" />
    </LinearLayout>

</LinearLayout>
