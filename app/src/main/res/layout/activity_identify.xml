<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Identify &amp; Attendance"
            android:textColor="@color/neon_cyan"
            android:textSize="26sp"
            android:textStyle="bold"
            android:shadowColor="@color/neon_cyan"
            android:shadowRadius="10" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan finger on R307S to log attendance"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="24dp" />

        <!-- Start Scan Button -->
        <Button
            android:id="@+id/btnStartScanFingerprint"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_button_cyan"
            android:text=" Scan Fingerprint Now"
            android:textColor="@color/bg_dark_obsidian"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBarIdentify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Status Box -->
        <TextView
            android:id="@+id/tvIdentifyStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Press 'Scan Fingerprint Now' and place finger on the sensor."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Student Match Result Card -->
        <LinearLayout
            android:id="@+id/layoutMatchResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="MATCH FOUND "
                android:textColor="@color/neon_emerald"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvMatchName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvMatchRoll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Roll No: --"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvMatchDept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Department: --"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvMatchFingerId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fingerprint ID: --"
                android:textColor="@color/neon_cyan"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvMatchAttendance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Attendance Logged: 1"
                android:textColor="@color/neon_emerald"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
