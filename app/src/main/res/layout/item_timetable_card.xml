<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardTimetableSlot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Row: Day Badge, Class Time & Attended Count Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvSlotDayBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_cyan"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="MON"
            android:textColor="@color/bg_dark_obsidian"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvClassTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="11:00 AM - 12:30 PM"
            android:textColor="@color/neon_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAttendedCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Attended: 0"
            android:textColor="@color/neon_emerald"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center: Subject Name & Code -->
    <TextView
        android:id="@+id/tvSubjectTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MPC - Mobile &amp; Pervasive Computing"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- Details Row: Faculty & Room -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvFacultyName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Faculty: Dr. Mitesh Solanki (MS)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvClassroom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room: MA106"
            android:textColor="@color/neon_amber"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Time Lock Status Banner -->
    <TextView
        android:id="@+id/tvLockStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:paddingVertical="6dp"
        android:paddingHorizontal="10dp"
        android:gravity="center"
        android:text="TAP TO MARK ATTENDANCE (ACTIVE CLASS TIME)"
        android:textColor="@color/neon_emerald"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
