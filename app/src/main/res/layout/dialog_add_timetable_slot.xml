<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Timetable Slot"
            android:textColor="@color/neon_cyan"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Day of Week:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerDay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/bg_input"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etStartTime"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@color/bg_input"
                android:hint="Start Time (e.g. 11:00)"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/etEndTime"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@color/bg_input"
                android:hint="End Time (e.g. 12:30)"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <AutoCompleteTextView
            android:id="@+id/etSubjectCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/bg_input"
            android:hint="Subject Code (e.g. MPC, PE, VPD) *"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp"
            android:completionThreshold="1"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <AutoCompleteTextView
            android:id="@+id/etSubjectName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/bg_input"
            android:hint="Subject Name (e.g. Mobile Computing)"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp"
            android:completionThreshold="1"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etFacultyInitials"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:background="@color/bg_input"
                android:hint="Initials (MS)"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginEnd="4dp" />

            <AutoCompleteTextView
                android:id="@+id/etFacultyName"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@color/bg_input"
                android:hint="Faculty (e.g. Dr. Mitesh Solanki)"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp"
                android:completionThreshold="1" />
        </LinearLayout>

        <AutoCompleteTextView
            android:id="@+id/etClassroom"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/bg_input"
            android:hint="Classroom / Lab (e.g. MA106)"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp"
            android:completionThreshold="1"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnCancelSlot"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/btnSaveSlot"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_cyan"
                android:text="Save Slot"
                android:textColor="@color/bg_dark_obsidian"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
