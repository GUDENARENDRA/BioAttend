<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/tvEditSlotPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Timetable Slot Editor"
            android:textColor="@color/neon_cyan"
            android:textSize="26sp"
            android:textStyle="bold"
            android:shadowColor="@color/neon_cyan"
            android:shadowRadius="10"
            android:layout_marginBottom="24dp" />

        <!-- Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <!-- Day Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day of Week *"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerPageDay"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#0F1626"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="16dp" />

            <!-- Time Row with AM/PM Selectors -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Start Time Block -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start Time *"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/etPageStartTime"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="#0F1626"
                        android:hint="Start Time (e.g. 11:00)"
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp"
                        android:layout_marginEnd="6dp" />

                    <Spinner
                        android:id="@+id/spinnerStartAmPm"
                        android:layout_width="100dp"
                        android:layout_height="50dp"
                        android:background="#0F1626"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>

                <!-- End Time Block -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="End Time *"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etPageEndTime"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="#0F1626"
                        android:hint="End Time (e.g. 12:30)"
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp"
                        android:layout_marginEnd="6dp" />

                    <Spinner
                        android:id="@+id/spinnerEndAmPm"
                        android:layout_width="100dp"
                        android:layout_height="50dp"
                        android:background="#0F1626"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Subject Code -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subject Code *"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <AutoCompleteTextView
                android:id="@+id/etPageSubjectCode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#0F1626"
                android:hint="e.g. MPC, PE, VPD"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:completionThreshold="1"
                android:layout_marginBottom="16dp" />

            <!-- Subject Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subject Full Name"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <AutoCompleteTextView
                android:id="@+id/etPageSubjectName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#0F1626"
                android:hint="e.g. Mobile Computing &amp; Wireless Communication"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:completionThreshold="1"
                android:layout_marginBottom="16dp" />

            <!-- Faculty Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Faculty Initials"
                        android:textColor="@color/neon_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etPageFacultyInitials"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="#0F1626"
                        android:hint="MS"
                        android:inputType="textCapCharacters"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Faculty Name"
                        android:textColor="@color/neon_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <AutoCompleteTextView
                        android:id="@+id/etPageFacultyName"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="#0F1626"
                        android:hint="Dr. Mitesh Solanki"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp"
                        android:completionThreshold="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Classroom -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Classroom / Lab Location"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <AutoCompleteTextView
                android:id="@+id/etPageClassroom"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#0F1626"
                android:hint="e.g. MA106"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:completionThreshold="1" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnSaveSlotRecord"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_button_cyan"
                android:text="SAVE SLOT"
                android:textColor="@color/bg_dark_obsidian"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCancelSlotRecord"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="CANCEL"
                android:textColor="@color/neon_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
