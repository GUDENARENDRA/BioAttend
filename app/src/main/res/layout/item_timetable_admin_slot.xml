<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvSlotDay"
        android:layout_width="55dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_button_cyan"
        android:text="MON"
        android:textColor="@color/bg_dark_obsidian"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvSlotTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11:00 - 12:30"
            android:textColor="@color/neon_amber"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSlotSubject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MPC - Mobile &amp; Pervasive Computing"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvSlotDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Faculty: Dr. Mitesh Solanki (MS) | Room: MA106"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnDeleteSlot"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/neon_red" />

</LinearLayout>
